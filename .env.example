# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding EXTERNAL API ONLY (Task 4): openai | jina | gemini
# No local embedding model is used. Copy to .env and fill the key for
# the chosen provider. Never commit real keys.
EMBEDDING_PROVIDER=openai
# Defaults per provider (override only if needed):
#   openai -> text-embedding-3-small
#   jina   -> jina-embeddings-v3
#   gemini -> text-embedding-004
EMBEDDING_MODEL=
# Optional custom endpoint base (OpenAI-compatible). Defaults:
#   openai -> https://api.openai.com/v1
#   jina   -> https://api.jina.ai/v1
EMBEDDING_API_BASE=

# Task 8 — PageIndex vectorless fallback (3 PDF chính sách dài).
# PAGEINDEX_API_KEY bắt buộc để upload/search PageIndex. Registry local:
# data/pageindex_registry.json (chỉ lưu IDs + hash, không lưu credentials).
PAGEINDEX_API_KEY=
# Timeout chờ indexing (giây) và khoảng poll khi upload tài liệu mới.
PAGEINDEX_READY_TIMEOUT_S=900
PAGEINDEX_READY_POLL_S=15
# Timeout chờ kết quả retrieval (giây) và khoảng poll mỗi fallback search.
PAGEINDEX_SEARCH_TIMEOUT_S=180
PAGEINDEX_SEARCH_POLL_S=3

# Optional services
JINA_API_KEY=

# Calibrated 2026-09-25: 0.5728 on 16 in-domain + 16 out-of-domain queries
# (details: group_project/evaluation/threshold_calibration.json).
# Leave empty to use the calibrated code default. Gate: Dense top-1 cosine
# score >= threshold keeps hybrid, below triggers PageIndex fallback.
SCORE_THRESHOLD=
