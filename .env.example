# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding EXTERNAL API ONLY (Task 4): openai | jina | gemini
# No local embedding model is used. Copy to .env and fill the key for
# the chosen provider. Never commit real keys.
EMBEDDING_PROVIDER=openai
# Defaults per provider (override only if needed):
#   openai -> text-embedding-3-small
#   jina   -> jina-embeddings-v3
#   gemini -> text-embedding-004
EMBEDDING_MODEL=
# Optional custom endpoint base (OpenAI-compatible). Defaults:
#   openai -> https://api.openai.com/v1
#   jina   -> https://api.jina.ai/v1
EMBEDDING_API_BASE=

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
